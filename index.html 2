

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>My Notes</title>

<style>

* {

  box-sizing: border-box;

}

body {

  margin: 0;

  padding: 20px;

  font-family: Arial, sans-serif;

  background: #101827;

  color: white;

}

.container {

  max-width: 600px;

  margin: auto;

}

header {

  text-align: center;

  padding: 20px;

}

header h1 {

  color: #a78bfa;

  font-size: 32px;

}

header p {

  color: #aab4c5;

}

.search {

  width: 100%;

  padding: 15px;

  border-radius: 12px;

  border: 1px solid #39465c;

  background: #202d42;

  color: white;

  font-size: 16px;

  margin-bottom: 15px;

}

.form {

  background: #202d42;

  padding: 18px;

  border-radius: 18px;

  margin-bottom: 20px;

}

input, textarea {

  width: 100%;

  padding: 14px;

  margin-bottom: 12px;

  border-radius: 10px;

  border: none;

  background: #34435c;

  color: white;

  font-size: 16px;

}

textarea {

  height: 110px;

  resize: vertical;

}

button {

  padding: 13px;

  border: none;

  border-radius: 10px;

  background: #8b5cf6;

  color: white;

  font-size: 16px;

  font-weight: bold;

  cursor: pointer;

}

.add {

  width: 100%;

}

.note {

  background: #202d42;

  padding: 18px;

  border-radius: 15px;

  margin-bottom: 12px;

  border-left: 4px solid #a78bfa;

}

.note h3 {

  margin-top: 0;

  color: #c4b5fd;

}

.note p {

  white-space: pre-wrap;

  overflow-wrap: anywhere;

  color: #dce3ef;

}

.actions {

  display: flex;

  gap: 8px;

}

.actions button {

  flex: 1;

  font-size: 13px;

}

.delete {

  background: #e11d48;

}

.edit {

  background: #0d9488;

}

.date {

  color: #9caac0;

  font-size: 12px;

  margin-bottom: 12px;

}

.empty {

  text-align: center;

  color: #aab4c5;

  padding: 30px;

}

</style>

</head>

<body>

<div class="container">

<header>

  <h1>📝 My Notes</h1>

  <p>All your ideas in one place</p>

</header>

<input

  class="search"

  id="search"

  placeholder="🔍 Search notes..."

>

<div class="form">

  <input id="title" placeholder="Note title">

  <textarea

    id="content"

    placeholder="Write your note here..."

  ></textarea>

  <button class="add" id="saveButton"

    onclick="saveNote()">

    + Add Note

  </button>

</div>

<h2>📚 My Notes</h2>

<div id="notes"></div>

</div>

<script>

let notes = [];

try {

  notes = JSON.parse(

    localStorage.getItem("myNotes") || "[]"

  );

} catch {

  notes = [];

}

let editingId = null;

function saveData() {

  localStorage.setItem(

    "myNotes",

    JSON.stringify(notes)

  );

}

function saveNote() {

  const title = document

    .getElementById("title").value.trim();

  const content = document

    .getElementById("content").value.trim();

  if (!title || !content) {

    alert("Please enter a title and note!");

    return;

  }

  if (editingId !== null) {

    const note = notes.find(

      n => n.id === editingId

    );

    note.title = title;

    note.content = content;

    note.date = new Date().toLocaleString();

    editingId = null;

    document.getElementById("saveButton")

      .textContent = "+ Add Note";

  } else {

    notes.unshift({

      id: Date.now(),

      title: title,

      content: content,

      date: new Date().toLocaleString()

    });

  }

  saveData();

  document.getElementById("title").value = "";

  document.getElementById("content").value = "";

  renderNotes();

}

function deleteNote(id) {

  if (!confirm("Are you sure you want to delete this note?")) {

    return;

  }

  notes = notes.filter(n => n.id !== id);

  saveData();

  renderNotes();

}

function editNote(id) {

  const note = notes.find(n => n.id === id);

  document.getElementById("title").value =

    note.title;

  document.getElementById("content").value =

    note.content;

  editingId = id;

  document.getElementById("saveButton")

    .textContent = "💾 Save Changes";

  window.scrollTo({

    top: 0,

    behavior: "smooth"

  });

}

function renderNotes() {

  const list = document.getElementById("notes");

  const search = document

    .getElementById("search").value

    .toLowerCase();

  list.replaceChildren();

  const filtered = notes.filter(note =>

    note.title.toLowerCase().includes(search) ||

    note.content.toLowerCase().includes(search)

  );

  if (filtered.length === 0) {

    const empty = document.createElement("div");

    empty.className = "empty";

    empty.textContent = "No notes found 📝";

    list.appendChild(empty);

    return;

  }

  filtered.forEach(note => {

    const card = document.createElement("div");

    card.className = "note";

    const title = document.createElement("h3");

    title.textContent = note.title;

    const content = document.createElement("p");

    content.textContent = note.content;

    const date = document.createElement("div");

    date.className = "date";

    date.textContent = note.date;

    const actions = document.createElement("div");

    actions.className = "actions";

    const edit = document.createElement("button");

    edit.className = "edit";

    edit.textContent = "Edit";

    edit.onclick = () => editNote(note.id);

    const del = document.createElement("button");

    del.className = "delete";

    del.textContent = "Delete";

    del.onclick = () => deleteNote(note.id);

    actions.append(edit, del);

    card.append(title, content, date, actions);

    list.appendChild(card);

  });

}

document.getElementById("search")

  .addEventListener("input", renderNotes);

renderNotes();

</script>

</body>

</html>
